{
  "name": "together-agent",
  "version": "0.2.2",
  "description": "Whatever",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "together-agent": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm run build:cli && pnpm run build:agent && pnpm run build:creator && pnpm run postbuild",
    "build:cli": "tsc",
    "build:agent": "node build-agent.js",
    "build:creator": "node dist/cli.js build creator-agent && mkdir -p dist/creator-agent && cp -r creator-agent/dist/* dist/creator-agent/ && cp creator-agent/package.json dist/creator-agent/",
    "postbuild": "chmod +x dist/cli.js && chmod +x dist/agent/index.js",
    "dev": "tsc --watch",
    "start": "node dist/cli.js",
    "test": "vitest",
    "test:coverage": "vitest --coverage"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^2.0.0",
    "esbuild": "^0.27.1",
    "typescript": "^5.7.2",
    "vitest": "^2.0.0"
  },
  "dependencies": {
    "@ai-sdk/togetherai": "^1.0.30",
    "@babel/core": "^7.28.6",
    "@babel/plugin-transform-react-jsx": "^7.28.6",
    "@codesandbox/sdk": "^2.4.2",
    "acorn": "^8.15.0",
    "acorn-jsx": "^5.3.2",
    "ai": "^5.0.113",
    "ai-code-tools": "^1.0.2",
    "commander": "^12.1.0",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "fast-glob": "^3.3.2",
    "zod": "^4.2.1"
  }
}
