{
  "name": "together-agent",
  "version": "0.1.0",
  "description": "Build AI agents with custom tools powered by Together AI",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "together-agent": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm run build:cli && pnpm run build:agent && pnpm run build:creator && pnpm run postbuild",
    "build:cli": "tsc",
    "build:agent": "node build-agent.js",
    "build:creator": "node dist/cli.js build creator-agent && mkdir -p dist/creator-agent && cp -r creator-agent/dist/* dist/creator-agent/ && cp creator-agent/package.json dist/creator-agent/",
    "postbuild": "chmod +x dist/cli.js && chmod +x dist/agent/index.js",
    "dev": "tsc --watch",
    "start": "node dist/cli.js"
  },
  "keywords": [
    "ai",
    "agent",
    "together",
    "tools",
    "cli",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.2",
    "esbuild": "^0.27.1",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "@ai-sdk/togetherai": "^1.0.30",
    "@codesandbox/sdk": "^2.4.2",
    "acorn": "^8.15.0",
    "ai": "^5.0.113",
    "ai-code-tools": "^1.0.2",
    "commander": "^12.1.0",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "fast-glob": "^3.3.2",
    "zod": "^4.2.1"
  }
}
